msgctxt "Tr"
msgid "Open FastSync"
msgstr "Abrir o FastSync"

msgctxt "Tr"
msgid "Sync now"
msgstr "Sincronizar agora"

msgctxt "Tr"
msgid "Pause syncing"
msgstr "Pausar a sincronização"

msgctxt "Tr"
msgid "Resume syncing"
msgstr "Retomar a sincronização"

msgctxt "Tr"
msgid "Quit"
msgstr "Sair"

msgctxt "Tr"
msgid "Everything is up to date"
msgstr "Tudo está atualizado"

msgctxt "Tr"
msgid "Syncing…"
msgstr "Sincronizando…"

msgctxt "Tr"
msgid "Paused"
msgstr "Pausado"

msgctxt "Tr"
msgid "Needs attention"
msgstr "Precisa de atenção"

msgctxt "Tr"
msgid "No accounts"
msgstr "Nenhuma conta"

msgctxt "Tr"
msgid "Choose a local folder, for example /home/you/Dropbox."
msgstr "Escolha uma pasta local, por exemplo /home/voce/Dropbox."

msgctxt "Tr"
msgid "Another account already syncs that folder."
msgstr "Outra conta já sincroniza essa pasta."

msgctxt "Tr"
msgid "Choose a different folder: this one holds your whole home folder or FastSync's own data."
msgstr "Escolha outra pasta: esta contém toda a sua pasta pessoal ou os dados do próprio FastSync."

msgctxt "Tr"
msgid "Fill in both the client ID and the client secret, without spaces, or turn the option off."
msgstr "Preencha o ID e o segredo do cliente, sem espaços, ou desative a opção."

msgctxt "Tr"
msgid "Your rclone was built without support for this service (Debian and Ubuntu's rclone leaves some out). Install the official rclone from rclone.org, or use the Flatpak."
msgstr "O seu rclone foi compilado sem suporte a este serviço (o rclone do Debian e do Ubuntu deixa alguns de fora). Instale o rclone oficial em rclone.org ou use o Flatpak."

msgctxt "Tr"
msgid "Open folder"
msgstr "Abrir pasta"

msgctxt "Tr"
msgid "Login failed: {}"
msgstr "Falha no login: {}"

msgctxt "Main"
msgid "Add account"
msgstr "Adicionar conta"

msgctxt "Main"
msgid "Preferences"
msgstr "Preferências"

msgctxt "Main"
msgid "rclone was not found. FastSync needs it to talk to the cloud. Install it (rclone.org) and restart."
msgstr "O rclone não foi encontrado. O FastSync precisa dele para falar com a nuvem. Instale-o (rclone.org) e reinicie."

msgctxt "Main"
msgid "No accounts yet"
msgstr "Nenhuma conta ainda"

msgctxt "Main"
msgid "Add an account and choose a folder: its files stay in sync both ways and available offline."
msgstr "Adicione uma conta e escolha uma pasta: os arquivos ficam sincronizados nos dois sentidos e disponíveis offline."

