msgctxt "Tr"
msgid "{} of {} files in {} would be deleted. Nothing was deleted yet: open FastSync to review."
msgstr "{} de {} arquivos em {} seriam apagados. Nada foi apagado ainda: abra o FastSync para revisar."

msgctxt "Tr"
msgid "Show file"
msgstr "Mostrar arquivo"

msgctxt "LogDialog"
msgid "Show file"
msgstr "Mostrar arquivo"

msgctxt "Tr"
msgid "A file changed on both sides"
msgstr "Um arquivo mudou nos dois lados"

msgctxt "Tr"
msgid "{} changed here and in {}. Both copies were kept: the local one is now named “(conflict …)”."
msgstr "{} mudou aqui e em {}. As duas cópias foram mantidas: a local agora se chama “(conflict …)”."

msgctxt "Tr"
msgid "{} files changed here and in {}, starting with {}. Both copies of each were kept: the local ones are now named “(conflict …)”."
msgstr "{} arquivos mudaram aqui e em {}, começando por {}. As duas cópias de cada um foram mantidas: as locais agora se chamam “(conflict …)”."

msgctxt "Tr"
msgid "Choose a local folder, for example /home/you/Dropbox."
msgstr "Escolha uma pasta local, por exemplo /home/voce/Dropbox."

msgctxt "Tr"
msgid "Another account already syncs that folder."
msgstr "Outra conta já sincroniza essa pasta."

msgctxt "Tr"
msgid "Choose a different folder: this one holds your whole home folder or FastSync's own data."
msgstr "Escolha outra pasta: esta contém toda a sua pasta pessoal ou os dados do próprio FastSync."

msgctxt "Tr"
msgid "Fill in both the client ID and the client secret, without spaces, or turn the option off."
msgstr "Preencha o ID e o segredo do cliente, sem espaços, ou desative a opção."

msgctxt "Tr"
msgid "Your rclone was built without support for this service (Debian and Ubuntu's rclone leaves some out). Install the official rclone from rclone.org, or use the Flatpak."
msgstr "O seu rclone foi compilado sem suporte a este serviço (o rclone do Debian e do Ubuntu deixa alguns de fora). Instale o rclone oficial em rclone.org ou use o Flatpak."

msgctxt "Tr"
msgid "Open folder"
msgstr "Abrir pasta"

msgctxt "Tr"
msgid "Login failed: {}"
msgstr "Falha no login: {}"

msgctxt "Tr"
msgid "Choose a folder that is neither inside nor around this account's current folder."
msgstr "Escolha uma pasta que não esteja dentro nem em volta da pasta atual desta conta."

msgctxt "Tr"
msgid "Could not list the folders: {}"
msgstr "Não foi possível listar as pastas: {}"

msgctxt "Tr"
msgid "This file is not in a synced folder of FastSync, so it has no cloud copy to share."
msgstr "Este arquivo não está em uma pasta sincronizada do FastSync, então não tem cópia na nuvem para compartilhar."

msgctxt "Tr"
msgid "This file is not in the cloud yet. Wait for the sync to finish and try again."
msgstr "Este arquivo ainda não está na nuvem. Espere a sincronização terminar e tente de novo."

msgctxt "Tr"
msgid "Could not create the link: {}"
msgstr "Não foi possível criar o link: {}"

